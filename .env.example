# -------------------------------------
# PERIDOT KERNEL ENVIRONMENT VARIABLES
# -------------------------------------
# Generate a secure string for your deployment
API_KEY=your_secure_api_key_here

# Telemetry Suppression (forces true air-gapped sovereign mode).
# These are ALSO force-set to 1 by config.py at boot -- the main process is
# air-gapped unconditionally. Model downloads run in an isolated child
# process (core_system/model_fetch.py), never in the running kernel.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
