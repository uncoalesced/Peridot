# Engineered by uncoalesced
# -------------------------------------
# PERIDOT KERNEL ENVIRONMENT VARIABLES
# -------------------------------------
# Every variable Peridot reads is listed here. Values shown after "default:" are
# what config.py (or core.py, where noted) falls back to when the variable is
# unset -- uncomment a line only to override it. Some defaults are computed from
# detected hardware and are shown as the formula rather than a fixed number.

# Generate a secure string for your deployment.
# If left unset, config.py mints a 32-byte key with secrets.token_hex(32) and
# writes it back into this file's real counterpart (.env) on first boot.
API_KEY=your_secure_api_key_here

# Telemetry Suppression (forces true air-gapped sovereign mode).
# These are ALSO force-set to 1 by config.py at boot -- the main process is
# air-gapped unconditionally. Model downloads run in an isolated child
# process (core_system/model_fetch.py), never in the running kernel.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# -------------------------------------
# MODEL SELECTION
# -------------------------------------
# Filename inside models/. Must be a GGUF; the provider registry routes by
# extension (core_system/providers).
# ACTIVE_MODEL_NAME=Qwen2.5-14B-Instruct-Q4_K_M.gguf

# -------------------------------------
# HARDWARE SCALING
# -------------------------------------
# Layers offloaded to the GPU. Default is auto-calculated from detected VRAM
# and model size by config._calculate_gpu_layers(); an operator override here
# always wins. 0 forces CPU-only.
# GPU_LAYERS=

# Context window in tokens. Default is VRAM-derived: 8192 above 10GB VRAM,
# 4096 at or below 10GB, 2048 on CPU-only.
# CONTEXT_LENGTH=

# MAX_TOKENS=1024
# Decode threads; default = physical CPU cores. THREADS_BATCH (prefill)
# defaults to logical cores.
# THREADS=
# THREADS_BATCH=
# BATCH_SIZE=1024
# Physical micro-batch per GPU launch (smaller = smaller CUDA compute buffer).
# UBATCH_SIZE=512
# KV cache precision: f16 | q8_0 | q4_0. q8_0 halves KV VRAM (more context)
# but measurably degraded the 1.6-bit default 27B, so f16 is the default.
# Speed: python -m benchmarking.benchmark_decode_rate --sweep (check quality too)
# KV_CACHE_TYPE=f16

# ZAT-SCS predictive preemption: always-on microphone level stream + global
# keyboard hook used to pre-warm the GPU before you hit send. Off by default.
# ZAT_SCS_ENABLED=0

# -------------------------------------
# SAMPLING
# -------------------------------------
# Defaults follow Qwen's published recommendations for thinking mode. Do not
# drop TEMPERATURE toward 0: near-greedy sampling makes Qwen3-family models
# lock onto degenerate repeated patterns (see the note in config.py).
# TEMPERATURE=0.6
# TOP_P=0.95
# TOP_K=20
# REPEAT_PENALTY=1.1

# -------------------------------------
# NETWORK
# -------------------------------------
# The Flask backend's bind address. Keep it on loopback unless you know why
# you are changing it -- there is no TLS and the only auth is the bearer key.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=5000

# Seconds the launcher waits for the engine to exit on shutdown.
# SHUTDOWN_TIMEOUT=2

# Set by config.py at boot to mirror API_KEY, so client-side helpers can pick
# the key up out of the environment. Not something you normally set by hand.
# PERIDOT_AUTH_TOKEN=

# -------------------------------------
# MEDICAL RESEARCH CLUSTER (Folding@home v8)
# -------------------------------------
# Idle seconds before the kernel yields VRAM to the research workload.
# RESEARCH_IDLE_THRESHOLD=30
# Polling interval in seconds for the idle monitor.
# RESEARCH_CHECK_INTERVAL=10

# -------------------------------------
# CLIENT SESSION BEHAVIOUR (core.py)
# -------------------------------------
# How long a previous conversation stays resumable, in seconds. Default 21600
# (6 hours).
# SESSION_RESUME_WINDOW_S=21600
