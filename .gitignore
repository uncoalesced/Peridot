*.index
*.faiss
*.pkl
*.bin

# TurboVec index files (excluded from version control)
storage/vector_db/
aether_cold_storage.db

# Extra ignored directories
llama.cpp/
models/

# Metadata and documentation files to ignore
CLAUDE.md
AGENTS.md
AUDIT.MD
