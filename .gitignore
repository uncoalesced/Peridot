# -----------------------------------------------------------------------------
# PERIDOT SOVEREIGN KERNEL | .gitignore
# Engineered by uncoalesced.
# -----------------------------------------------------------------------------

# Peridot Sovereign Data & RAG Memory
processed/
results/

# Environments & Secrets
venv/
env/
benchmarking/venv/
.env

# Logs & Telemetry
logs/
*.log
mirror/

# Cache & Temporary Files
__pycache__/
*.py[cod]
*$py.class
.cache/
backups/
*.bak
*.tmp

# Model Files
models/*.gguf
models/*.bin

# Binaries & Executables
*.exe
ffmpeg.exe

# Medical Research Module
cores/
work/
client.db
gpus.json

# OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Data & Artifacts
input/*
!input/.gitkeep
storage/
logs/

# Legacy FAISS artifacts (v1.5.x and earlier)
*.index
*.faiss
*.pkl
*.bin

# TurboVec index files (excluded from version control)
storage/vector_db/
aether_cold_storage.db

# Extra ignored directories
llama.cpp/
models/

# Metadata and documentation files to ignore
CLAUDE.md
AGENTS.md
AUDIT.MD
MASTER_CONTEXT.md
ROUTINES.md
SKILL.md

# Cowork agent working folder (meta-docs, not shipped product)
cowork/

# Scratch handoff docs for other agents/tools working this repo
.temp/

# Python packaging artifacts. `python -m build` produces these at the repo root;
# it previously failed outright (setuptools exec'd the interactive setup.py
# wizard mid-build), so nothing here ever needed ignoring before.
build/
dist/
*.egg-info/
*.whl

# v1.6.0: user-installed skills/plugins (bundled sources live in core_system/extensions/bundled)
/extensions/
.env.lock
