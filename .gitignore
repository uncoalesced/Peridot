venv/
env/
benchmarking/venv/
.env

# Logs & Telemetry
logs/
*.log

# Cache & Temporary Files
__pycache__/
*.py[cod]
*$py.class
.cache/
backups/
*.bak
*.tmp

# Model Files
models/*.gguf
models/*.bin

# Binaries & Executables
*.exe
ffmpeg.exe

# Medical Research Module
cores/
work/
client.db
gpus.json

# OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Data & Artifacts
input/*
!input/.gitkeep
storage/
logs/

